{
  "name": "ceu-de-lavanda-catalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-responsive-images.mjs && next dev",
    "build": "node scripts/generate-responsive-images.mjs && next build",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "assets:responsive": "node scripts/generate-responsive-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "typescript": "^5",
    "sharp": "0.35.5"
  },
  "packageManager": "pnpm@12.14.0"
}
